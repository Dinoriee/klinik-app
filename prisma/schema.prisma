// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  dokter
  perawat
}

enum TipePresensi {
  sakit
  hamil
  laktasi
  umum
}

enum PresensiMedis {
  hadir
  izin
}

enum JenisObat {
  tablet
  kapsul
  sirup
  salep
  injeksi
  tetes
  puyer
}

model User {
  id_user     String        @id @default(cuid())
  email       String        @unique
  password    String
  name        String
  role        Role
  tenagaMedis Tenaga_Medis?
}

model Tenaga_Medis {
  id_tenaga_medis   String                  @id @default(cuid())
  id_user           String                  @unique
  kode_tenaga_medis String
  nik               String                  @unique
  nama_tenaga_medis String
  jabatan           String
  users             User                    @relation(fields: [id_user], references: [id_user])
  permintaanObats   Permintaan_Obat[]
  presensis         Presensi_Tenaga_Medis[]

  @@index([id_tenaga_medis, nik])
}

model Pegawai {
  id_pegawai      String            @id @default(cuid())
  nomor_pegawai   String            @unique
  nik             String            @unique
  nama_pegawai    String
  departemen      String
  permintaanObats Permintaan_Obat[]
  presensis       Presensi[]

  @@index([id_pegawai, nik])
}

model Penyakit {
  id_penyakit     String            @id @default(cuid())
  nama_penyakit   String
  permintaan_obat Permintaan_Obat[]
}

model Permintaan_Obat {
  id_permintaan     String                   @id @default(cuid())
  id_pegawai        String
  id_tenaga_medis   String
  id_penyakit       String
  waktu_permintaan  DateTime                 @default(now())
  pegawai           Pegawai                  @relation(fields: [id_pegawai], references: [id_pegawai])
  tenaga_medis      Tenaga_Medis             @relation(fields: [id_tenaga_medis], references: [id_tenaga_medis])
  penyakit          Penyakit                 @relation(fields: [id_penyakit], references: [id_penyakit])
  detail_permintaan Detail_Permintaan_Obat[]

  @@index([id_pegawai, id_tenaga_medis])
}

model Obat {
  id_obat           String                   @id @default(cuid())
  nama_obat         String
  nama_batch        String
  stok_saat_ini     Int
  satuan            String
  expired_date      DateTime
  reorder_level     Int
  jenis_obat        JenisObat
  detail_permintaan Detail_Permintaan_Obat[]
  notifikasi        Notifikasi[]
}

model Detail_Permintaan_Obat {
  id_permintaan   String
  id_obat         String
  jumlah_diminta  Int
  permintaan_obat Permintaan_Obat @relation(fields: [id_permintaan], references: [id_permintaan])
  obat            Obat            @relation(fields: [id_obat], references: [id_obat])

  @@id([id_permintaan])
}

model Presensi {
  id_presensi String       @id @default(cuid())
  id_pegawai  String
  jam_masuk   DateTime     @default(now())
  jam_keluar  DateTime?
  tipe        TipePresensi
  pegawai     Pegawai      @relation(fields: [id_pegawai], references: [id_pegawai])

  @@index([id_pegawai])
  @@index([jam_masuk])
}

model Presensi_Tenaga_Medis {
  id_presensi     String        @id @default(cuid())
  id_tenaga_medis String
  jam_masuk       DateTime      @default(now())
  jam_keluar      DateTime?
  keterangan      PresensiMedis
  tenagaMedis     Tenaga_Medis  @relation(fields: [id_tenaga_medis], references: [id_tenaga_medis])

  @@index([id_tenaga_medis])
  @@index([jam_masuk])
}

model Notifikasi {
  id_notifikasi String @id @default(cuid())
  id_obat       String
  pesan         String
  status        String
  obat          Obat   @relation(fields: [id_obat], references: [id_obat])
}
